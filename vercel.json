{
  "functions": {
    "api/submit.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/misterminit",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/misterminit",
      "destination": "/index.html"
    },
    {
      "source": "/misterminit/",
      "destination": "/index.html"
    },
    {
      "source": "/misterminit/api/submit",
      "destination": "/api/submit"
    },
    {
      "source": "/misterminit/api/pricing",
      "destination": "/api/pricing"
    },
    {
      "source": "/misterminit/api/xero/:action",
      "destination": "/api/xero?action=:action"
    }
  ],
  "headers": [
    {
      "source": "/api/(submit|xero)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/xero?action=refresh",
      "schedule": "0 18 * * *"
    }
  ]
}
