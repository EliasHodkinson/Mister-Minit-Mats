# Microsoft Entra App Registration (client-credentials, application permission Mail.Send)
MS_APPLICATION_CLIENT_ID=XXXXXX
MS_DIRECTORY_TENANT_ID=XXXXXXX
MS_APP_CLIENT_SECRET=XXXXXXXX

# Mailbox the emails are sent from (the app must be allowed to send as it)
MAIL_FROM=marketing@ankord.com.au
# Where the designer's copy goes (comma-separate for more than one)
MAIL_TO=marketing@ankord.com.au

# Google reCAPTCHA v3 – the SECRET key for site key 6LfNPbAtAAAAAOil4sqqR-kSuGDs-WqF8sbNitSX
RECAPTCHA_SECRET_KEY=XXXXXXXX
# Optional: block submissions scoring below this (0 = bot … 1 = human). Default 0.5
# RECAPTCHA_MIN_SCORE=0.5

# Optional rate limits (submissions per window). Defaults: 5 per IP / 10 min, 3 per email / hour, 100 total / hour
# RATE_LIMIT_IP=5
# RATE_LIMIT_IP_WINDOW_SEC=600
# RATE_LIMIT_EMAIL=3
# RATE_LIMIT_EMAIL_WINDOW_SEC=3600
# RATE_LIMIT_GLOBAL=100
# RATE_LIMIT_GLOBAL_WINDOW_SEC=3600
# Optional: make the limits global across all serverless instances by adding Upstash Redis
# (Vercel Marketplace → Upstash for Redis sets these automatically)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: only needed if the builder page is hosted on a different origin from this API,
# e.g. embedded on the main website. Comma-separate for more than one.
# ALLOWED_ORIGIN=https://www.ankord.com.au

# ---- Pricing (shown on the page and used for the quote) ----
# First mat includes design time; every further mat is the reprint price; freight is once per order.
MAT_PRICE_FIRST=250
MAT_PRICE_EXTRA=150
FREIGHT_PRICE=25
# Prices above include GST and quotes are raised "Tax inclusive" (default). Set false to add GST on top.
PRICES_INCLUDE_GST=true
# DESIGN_MINUTES_INCLUDED=45

# ---- Xero (Web app – see README) ----
# Leave these unset and briefs are still emailed, just without a quote.
XERO_CLIENT_ID=XXXXXXXX
XERO_CLIENT_SECRET=XXXXXXXX
# Long random string: open /misterminit/api/xero/connect?key=<this> once to connect Xero
XERO_ADMIN_KEY=XXXXXXXX
# Which organisation to use if the Xero login can see more than one (part of the name is enough)
XERO_ORG_NAME=Ankor'd
# Random string; Vercel sends it with the daily cron that keeps the Xero login alive
CRON_SECRET=XXXXXXXX
# The web app keeps its Xero login in Upstash for Redis (Vercel Marketplace sets these, and the rate limits use it too)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Optional overrides
# XERO_REDIRECT_URI=https://apps.ankord.com.au/misterminit/api/xero/callback
# XERO_SCOPES=openid profile email offline_access accounting.contacts accounting.invoices accounting.settings.read
# XERO_MODE=custom          # use a paid Custom Connection instead (client credentials, no store needed)
# XERO_TENANT_ID=           # custom connection only
# invoice (default) raises an approved invoice with an online "pay now" link; quote raises a quote instead
XERO_DOCUMENT=invoice
# Defaults already match QU-0003 (scripts/xero-inspect.js QU-0003); only set these to change them
# XERO_ACCOUNT_CODE=220
# XERO_TAX_TYPE=OUTPUT
# XERO_FREIGHT_ACCOUNT_CODE=280
# XERO_ITEM_CODE_FIRST=80x40cm Mat
# XERO_ITEM_CODE_EXTRA=80x40cm Mat
# XERO_ITEM_CODE_FREIGHT=FREIGHT
# XERO_BRANDING_THEME_ID=f1738545-71a6-4461-b30c-71b8eb620fc5
# XERO_QUOTE_TERMS=Payment is due before design work begins.\nMats are printed after you approve your mockup.
# XERO_QUOTE_EXPIRY_DAYS=30
# XERO_QUOTE_STATUS=SENT
# XERO_INVOICE_DUE_DAYS=7
