# Microsoft Entra App Registration (client-credentials, application permission Mail.Send)
MS_APPLICATION_CLIENT_ID=XXXXXX
MS_DIRECTORY_TENANT_ID=XXXXXXX
MS_APP_CLIENT_SECRET=XXXXXXXX

# Mailbox the emails are sent from (the app must be allowed to send as it)
MAIL_FROM=marketing@ankord.com.au
# Where the designer's copy goes (comma-separate for more than one)
MAIL_TO=marketing@ankord.com.au

# Google reCAPTCHA v3 – the SECRET key for site key 6LfNPbAtAAAAAOil4sqqR-kSuGDs-WqF8sbNitSX
RECAPTCHA_SECRET_KEY=XXXXXXXX
# Optional: block submissions scoring below this (0 = bot … 1 = human). Default 0.5
# RECAPTCHA_MIN_SCORE=0.5

# Optional rate limits (submissions per window). Defaults: 5 per IP / 10 min, 3 per email / hour, 100 total / hour
# RATE_LIMIT_IP=5
# RATE_LIMIT_IP_WINDOW_SEC=600
# RATE_LIMIT_EMAIL=3
# RATE_LIMIT_EMAIL_WINDOW_SEC=3600
# RATE_LIMIT_GLOBAL=100
# RATE_LIMIT_GLOBAL_WINDOW_SEC=3600
# Optional: make the limits global across all serverless instances by adding Upstash Redis
# (Vercel Marketplace → Upstash for Redis sets these automatically)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: only needed if the builder page is hosted on a different origin from this API,
# e.g. embedded on the main website. Comma-separate for more than one.
# ALLOWED_ORIGIN=https://www.ankord.com.au
